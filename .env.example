# ============================================================
# CreatiHub environment configuration
# Copy this file to ".env" and fill in your values, then start
# the server with:  node server.js  (env vars are read from the
# process environment — load them with `export`, a process
# manager like PM2, or your host's env-var settings)
# ============================================================

# ---------------- Paystack ----------------
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys (sk_test_/pk_test_) while developing, LIVE keys in production.

# Secret key — REQUIRED for real payments. Never expose it to the frontend.
# When this is empty, CreatiHub runs in TEST/DEMO mode and simulates payments.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public key — used by the browser to open the Paystack inline popup.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the URL Paystack redirects to after payment.
# Defaults to https://your-domain/payment/callback
# PAYSTACK_CALLBACK_URL=https://your-domain.com/payment/callback

# ---------------- Server ----------------
# PORT=3000

# ---------------- Database (PRODUCTION) ----------------
# Set DATABASE_URL to a PostgreSQL connection string for BULLETPROOF
# persistence. Your users' accounts, orders, and subscriptions will survive
# redeploys, restarts, and crashes. Without this, CreatiHub uses a local
# JSON file (data/db.json) which can be lost on ephemeral hosting.
#
# Get a free Postgres from: Render, Railway, Supabase, or Neon.
# DATABASE_URL=postgresql://user:password@host:5432/database
#
# Set PGSSL=false ONLY for local Postgres without SSL. Leave unset for
# production (hosted Postgres requires SSL).
# PGSSL=false
